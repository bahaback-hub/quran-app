{
  "name": "quran-app-refactored",
  "version": "2.0.0",
  "description": "Quran Web App — Refactored to 10/10 quality (Layered Architecture, Type Safety, No !important, Proper Templates, DI, Error Boundaries)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ --no-warn-ignored",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write 'src/**/*.{js,ts}'"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "quran",
    "islam",
    "pwa",
    "typescript",
    "vite",
    "layered-architecture",
    "dependency-injection",
    "zod",
    "type-safe"
  ],
  "license": "MIT",
  "author": "Refactoring Project",
  "private": true,
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^9.0.0",
    "jsdom": "^29.1.1",
    "lightningcss": "^1.32.0",
    "prettier": "^3.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.8"
  }
}
