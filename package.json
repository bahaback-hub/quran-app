{
  "name": "quran-app",
  "version": "1.0.0",
  "description": "> تطبيق ويب احترافي للقرآن الكريم يعمل على جميع الأجهزة، قابل للتثبيت كتطبيق (PWA)، ويعمل أوفلاين.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.ci.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --headed",
    "android:build": "BUILD_TARGET=capacitor npm run build && npx cap sync",
    "android:open": "npx cap open android",
    "android:run": "npm run android:build && npx cap run android",
    "lint": "eslint src/ --no-warn-ignored",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write 'src/**/*.{js,ts,css}'",
    "format:check": "prettier --check 'src/**/*.{js,ts,css}'"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bahaback-hub/quran-app.git"
  },
  "bugs": {
    "url": "https://github.com/bahaback-hub/quran-app/issues"
  },
  "homepage": "https://bahaback-hub.github.io/quran-app/",
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.1",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "jsdom": "^29.1.1",
    "lightningcss": "^1.32.0",
    "prettier": "^3.0.0",
    "serve": "^14.2.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^8.0.14",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2"
  }
}
