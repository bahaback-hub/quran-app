{
  "name": "quran-app",
  "version": "3.1.29",
  "description": "Professional Quran Web App — Recitation, Audio, Search, Tafsir, Prayer Times, Adhkar & More (PWA/Android)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "mushaf:manifest": "node scripts/generate-mushaf-data-manifest.mjs",
    "verify:data": "node scripts/verify-quran-data.mjs",
    "build:seo": "node scripts/generate-seo-pages.mjs",
    "build:faq": "node scripts/generate-faq-pages.mjs",
    "optimize:brand": "node scripts/optimize-brand-images.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.ci.json",
    "typecheck:tests": "tsc --noEmit -p tsconfig.ci.tests.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --headed",
    "test:e2e:visual": "playwright test visual-regression",
    "android:build": "BUILD_TARGET=capacitor npm run build && npx cap sync",
    "android:release": "node scripts/build-release.mjs",
    "android:open": "npx cap open android",
    "android:run": "npm run android:build && npx cap run android",
    "lint": "eslint src/ --no-warn-ignored",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write 'src/**/*.{js,ts}'",
    "format:check": "prettier --check 'src/**/*.{js,ts}'",
    "lint:zero-style": "node scripts/check-zero-styles.mjs",
    "release": "npm run lint && npm run lint:zero-style && npm run typecheck && npm test && npm run build",
    "build:analyze": "vite build && node scripts/generate-csp-hashes.mjs",
    "test:a11y": "vite build --base=/ --outDir dist-a11y && (npx vite preview --outDir dist-a11y --port 4173 --base=/ &) && sleep 3 && node scripts/a11y-audit.mjs",
    "test:all": "npm run lint && npm run lint:zero-style && npm run typecheck && npm test && npm run test:e2e",
    "docs": "typedoc",
    "lighthouse:badge": "node scripts/update-lighthouse-badge.mjs",
    "perf:budget": "node scripts/check-performance-budget.mjs",
    "measure:surah": "node scripts/measure-surah-render.mjs",
    "shots:store": "node scripts/capture-store-screenshots.mjs",
    "knip": "knip --no-progress",
    "check:silent-catches": "node scripts/check-silent-catches.mjs",
    "check:i18n-parity": "node scripts/check-i18n-parity.mjs",
    "check:file-size": "node scripts/check-file-size-budget.mjs",
    "check:version": "node scripts/check-version-consistency.mjs",
    "check:coverage": "node scripts/check-per-file-coverage.mjs",
    "check:circular": "madge --circular --extensions ts src/",
    "device:check": "node scripts/device-check.mjs",
    "fonts:subset": "node scripts/subset-fonts.mjs",
    "release:publish": "node scripts/publish-release.mjs",
    "prepublishOnly": "npm run lint && npm run lint:zero-style && npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "quran",
    "islam",
    "pwa",
    "typescript",
    "vite",
    "prayer-times",
    "tafsir",
    "audio-player",
    "mushaf",
    "adhkar",
    "capacitor",
    "offline"
  ],
  "license": "MIT",
  "author": "bahaback-hub",
  "private": false,
  "overrides": {
    "uuid": "11.1.1",
    "minimatch": "^11.0.9",
    "glob": "^14.0.6",
    "rimraf": {
      "glob": "^14.0.6"
    }
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bahaback-hub/quran-app.git"
  },
  "bugs": {
    "url": "https://github.com/bahaback-hub/quran-app/issues"
  },
  "homepage": "https://bahaback-hub.github.io/quran-app/",
  "devDependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/cli": "8.6.2",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.10",
    "@typescript-eslint/eslint-plugin": "8.74.0",
    "@typescript-eslint/parser": "8.74.0",
    "@vitest/coverage-v8": "5.1.2",
    "axe-core": "4.14.1",
    "esbuild": "^0.28.0",
    "eslint": "^10.14.0",
    "fake-indexeddb": "6.2.8",
    "fontverter": "2.1.0",
    "globals": "^17.12.0",
    "jsdom": "31.0.1",
    "knip": "6.48.0",
    "lightningcss": "^1.32.0",
    "madge": "^8.0.0",
    "prettier": "3.10.1",
    "sharp": "0.35.5",
    "subset-font": "2.9.0",
    "typedoc": "^0.28.19",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "5.1.2"
  },
  "dependencies": {
    "@capacitor-community/speech-recognition": "7.0.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/geolocation": "8.2.5",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "adhan": "^4.4.6",
    "magvar": "2.2.0"
  }
}
