  },
  "homepage": "https://github.com/bahaback-hub/quran-app#readme",
  "devDependencies": {
    "@types/node": "^25.9.1",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  }
}
