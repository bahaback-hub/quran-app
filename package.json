{
  "name": "quran-app",
  "version": "1.0.0",
  "description": "> تطبيق ويب احترافي للقرآن الكريم يعمل على جميع الأجهزة، قابل للتثبيت كتطبيق (PWA)، ويعمل أوفلاين.",
  "type": "module",
  "scripts": {
    "dev": "npm run concat && vite",
    "build": "npm run concat && vite build",
    "preview": "vite preview",
    "concat": "node scripts/concat.cjs",
    "concat:watch": "node --watch scripts/concat.cjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bahaback-hub/quran-app.git"
  },
