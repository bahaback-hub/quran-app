{
  "name": "quran-app",
  "version": "2.2.0",
  "description": "Professional Quran Web App — Recitation, Audio, Search, Tafsir, Prayer Times, Adhkar & More (PWA/Android)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.ci.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --headed",
    "android:build": "BUILD_TARGET=capacitor npm run build && npx cap sync",
    "android:open": "npx cap open android",
    "android:run": "npm run android:build && npx cap run android",
    "lint": "eslint src/ --no-warn-ignored",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write 'src/**/*.{js,ts}'",
    "format:check": "prettier --check 'src/**/*.{js,ts}'",
    "release": "npm run lint && npm run typecheck && npm test && npm run build",
    "build:analyze": "vite build && node scripts/generate-csp-hashes.mjs",
    "test:a11y": "npm run build && npx serve dist -p 4173 & sleep 3 && node scripts/a11y-audit.mjs",
    "test:all": "npm run lint && npm run typecheck && npm test && npm run test:e2e",
    "docs": "typedoc",
    "lighthouse:badge": "node scripts/update-lighthouse-badge.mjs",
    "perf:budget": "node scripts/check-performance-budget.mjs",
    "knip": "knip --no-progress",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "quran",
    "islam",
    "pwa",
    "typescript",
    "vite",
    "prayer-times",
    "tafsir",
    "audio-player",
    "mushaf",
    "adhkar",
    "capacitor",
    "offline"
  ],
  "license": "MIT",
  "author": "bahaback-hub",
  "private": false,
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bahaback-hub/quran-app.git"
  },
  "bugs": {
    "url": "https://github.com/bahaback-hub/quran-app/issues"
  },
  "homepage": "https://bahaback-hub.github.io/quran-app/",
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.1",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "@vitest/coverage-v8": "^4.1.8",
    "axe-core": "4.12.1",
    "esbuild": "^0.28.0",
    "eslint": "^9.0.0",
    "fake-indexeddb": "^6.0.0",
    "globals": "^15.0.0",
    "jsdom": "^29.1.1",
    "knip": "6.17.1",
    "lightningcss": "^1.32.0",
    "prettier": "^3.0.0",
    "serve": "^14.2.6",
    "typedoc": "^0.28.19",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^8.0.14",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "adhan": "^4.4.4"
  }
}
