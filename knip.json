{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/main.ts",
    "src/prayer-local.ts",
    "src/reciters.ts",
    "src/web-vitals.ts",
    "src/memory-manager.ts",
    "src/offline-pack.ts",
    "src/mushaf-renderer.ts",
    "src/state/types.ts",
    "src/state/subscriptions.ts",
    "src/state/proxy.ts",
    "src/state/devtools.ts",
    "src/templates/index.ts",
    "src/templates/escape.ts",
    "src/__tests__/**/*.test.ts",
    "src/__tests__/mocks/**/*.ts",
    "e2e/**/*.spec.{ts,js}",
    "scripts/**/*.mjs"
  ],
  "project": ["src/**/*.ts", "scripts/**/*.mjs"],
  "ignoreBinaries": ["license-checker", "AGPL-3.0", "GPL-2.0"],
  "ignoreDependencies": [
    "@typescript-eslint/eslint-plugin",
    "@typescript-eslint/parser",
    "axe-core",
    "lightningcss",
    "serve",
    "@capacitor/status-bar",
    "@capacitor/splash-screen"
  ],
  "exclude": ["types", "unlisted"],
  "typescript": {
    "strict": true
  }
}
