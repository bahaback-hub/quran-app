{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/main.ts",
    "src/__tests__/**/*.test.ts",
    "e2e/**/*.spec.{ts,js}",
    "scripts/**/*.mjs"
  ],
  "project": ["src/**/*.ts", "scripts/**/*.mjs"],
  "ignore": [
    "src/translations/**",
    "src/types.ts",
    "src/search.ts",
    "src/global.d.ts"
  ],
  "ignoreBinaries": ["npx", "serve"],
  "typescript": {
    "strict": true
  }
}
