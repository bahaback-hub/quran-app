# Git attributes — ensure consistent behavior across platforms

# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Source code
# Every text rule repeats `eol=lf`: a later rule that only sets `text` would
# otherwise let core.autocrlf/core.eol decide the checkout bytes, and hashed
# datasets (public/data/*.json) must be byte-identical on every platform.
*.ts text eol=lf diff=typescript
*.js text eol=lf diff=javascript
*.css text eol=lf diff=css
*.html text eol=lf diff=html
*.json text eol=lf
*.yml text eol=lf diff=yaml
*.yaml text eol=lf diff=yaml

# Documentation
*.md text eol=lf diff=markdown
*.txt text eol=lf

# Shell scripts
*.sh text eol=lf

# Binary files — prevent Git from altering them
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mp3 binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.pdf binary
*.zip binary
